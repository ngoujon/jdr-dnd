# --- Base de donnees ---
POSTGRES_USER=tabletop
POSTGRES_PASSWORD=change-me-in-production
POSTGRES_DB=tabletop
DATABASE_URL=postgresql://tabletop:change-me-in-production@db:5432/tabletop?schema=public

# --- API ---
JWT_SECRET=change-me-a-long-random-string
JWT_EXPIRES_IN=30d
PORT=4000
NODE_ENV=production
# Taille max des fichiers uploades (octets) - 25 Mo
MAX_UPLOAD_BYTES=26214400
# Origines autorisees (CORS), separees par des virgules
CORS_ORIGINS=http://localhost:8080

# --- Web ---
WEB_PORT=8080
